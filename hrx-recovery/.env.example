# NEW recovery database only. Never point at the missing original baseline's database.
HRX_DB_URL=jdbc:postgresql://127.0.0.1:5432/hrx_recovery
HRX_DB_USER=hrx_recovery_app
HRX_DB_PASSWORD=SET_VIA_SECRET_MANAGER
HRX_MIGRATOR_USER=hrx_recovery_migrator
HRX_MIGRATOR_PASSWORD=SET_VIA_SECRET_MANAGER
HRX_MIGRATE=false
HRX_OIDC_ISSUER_URI=https://YOUR-IDP/issuer
HRX_OIDC_AUDIENCE=hrx-api
HRX_FILES_ENABLED=false
HRX_FILES_DIRECTORY=/var/lib/hrx-recovery/files
HRX_FILES_SCANNER=/usr/bin/clamscan
HRX_FILES_SIGNATURES=/var/lib/clamav
HRX_FILES_SCAN_REVISION=SET_TO_AUDITED_SIGNATURE_VERSION
